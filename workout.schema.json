{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyWhoosh coach workout contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "ftp_watts", "steps"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
    "description": {"type": "string", "maxLength": 2000},
    "author": {"type": "string", "maxLength": 120},
    "ftp_watts": {"type": "number", "minimum": 1, "maximum": 1000},
    "range_policy": {"enum": ["midpoint", "lower", "upper"], "default": "midpoint"},
    "steps": {"$ref": "#/$defs/steps"}
  },
  "$defs": {
    "watts": {"type": "number", "minimum": 0, "maximum": 3000},
    "pair": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/watts"}
    },
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {"oneOf": [{"$ref": "#/$defs/step"}, {"$ref": "#/$defs/repeat"}]}
    },
    "repeat": {
      "type": "object", "additionalProperties": false,
      "required": ["repeat", "steps"],
      "properties": {
        "repeat": {"type": "integer", "minimum": 1, "maximum": 100},
        "steps": {"$ref": "#/$defs/steps"}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["seconds"],
      "properties": {
        "seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "watts": {"oneOf": [{"$ref": "#/$defs/watts"}, {"$ref": "#/$defs/pair"}]},
        "ramp_watts": {"$ref": "#/$defs/pair"},
        "free_ride": {"const": true},
        "cadence": {"type": "integer", "minimum": 1, "maximum": 250},
        "text": {"type": "string", "maxLength": 500}
      },
      "oneOf": [{"required": ["watts"]}, {"required": ["ramp_watts"]}, {"required": ["free_ride"]}]
    }
  },
  "$comment": "The CLI additionally checks ordered watt ranges, control characters, at most 30 expanded steps, repeat nesting at most 5, and total duration at most 24 hours. Numeric limits are CLI guardrails, not physiological recommendations."
}
